PORT=3003
DATABASE_PATH=./data/sesi.db

# RM com exatamente 7 dígitos
BOOTSTRAP_ADMIN_RM=
BOOTSTRAP_ADMIN_NAME=
# E-mail institucional @senaisp.edu.br
BOOTSTRAP_ADMIN_EMAIL=
# Senha com pelo menos 12 caracteres (máximo de 72 bytes)
BOOTSTRAP_ADMIN_PASSWORD=
# Diretoria, Secretaria ou Orientador de Educação Digital
BOOTSTRAP_ADMIN_ROLE=

# SMTP do provedor de e-mail transacional
# Configure SMTP_HOST, SMTP_PORT e SMTP_FROM juntos para habilitar o envio.
SMTP_HOST=
SMTP_PORT=587
# true para TLS direto (normalmente porta 465); false para STARTTLS (normalmente 587)
SMTP_SECURE=false
# Informe ambos se o provedor exigir autenticação SMTP
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional em desenvolvimento local sem SMTP; nunca habilitar em produção
EXPOSE_PASSWORD_RESET_CODE=false

# Acesso local de desenvolvedor (RM de 4 dígitos; nunca configurar em produção)
DEV_ADMIN_RM=
