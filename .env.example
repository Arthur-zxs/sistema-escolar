PORT=3003
DATABASE_PATH=./data/sesi.db

# RM com exatamente 7 dígitos
BOOTSTRAP_ADMIN_RM=
BOOTSTRAP_ADMIN_NAME=
# E-mail institucional @senaisp.edu.br
BOOTSTRAP_ADMIN_EMAIL=
# Senha com pelo menos 12 caracteres (máximo de 72 bytes)
BOOTSTRAP_ADMIN_PASSWORD=
# Diretoria, Secretaria ou Orientador de Educação Digital
BOOTSTRAP_ADMIN_ROLE=

# SMTP obrigatório em produção para confirmação de e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Apenas em ambiente local sem SMTP; nunca habilitar em produção
EXPOSE_EMAIL_VERIFICATION_CODE=false

# Acesso local de desenvolvedor (RM de 4 dígitos; nunca configurar em produção)
DEV_ADMIN_RM=
